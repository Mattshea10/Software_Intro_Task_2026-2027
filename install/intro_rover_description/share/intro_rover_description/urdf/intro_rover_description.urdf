  <!-- Gazebo Harmonic Joint Position Controllers with clamped output forces -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_yaw</joint_name>
      <topic>/shoulder_yaw</topic>
      <p_gain>20.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>3.0</d_gain>
      <cmd_max>30.0</cmd_max>
      <cmd_min>-30.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_pitch</joint_name>
      <topic>/shoulder_pitch</topic>
      <p_gain>30.0</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>5.0</d_gain>
      <cmd_max>40.0</cmd_max>
      <cmd_min>-40.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>elbow_pitch</joint_name>
      <topic>/elbow_pitch</topic>
      <p_gain>25.0</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>4.0</d_gain>
      <cmd_max>35.0</cmd_max>
      <cmd_min>-35.0</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>elbow_roll</joint_name>
