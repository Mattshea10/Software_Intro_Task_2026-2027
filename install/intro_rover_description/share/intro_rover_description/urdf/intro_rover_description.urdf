    </visual>
    <collision>
      <origin xyz="0.10 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.08 0.05 0.03" />
      </geometry>
    </collision>
  </link>

  <joint name="wrist_roll" type="continuous">
    <origin xyz="-0.00381 -0.18515 0.12524" rpy="1.5871 -1.5404 -3.1416" />
    <parent link="wrist_pitch_link" />
    <child link="wrist_roll_link" />
    <axis xyz="1 0 0" />
    <dynamics damping="0.5" friction="0.1" />
  </joint>

  <link name="fr_swerve_yaw_link">
