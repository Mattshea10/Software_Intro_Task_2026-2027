<?xml version="1.0" encoding="utf-8"?>
<!-- Simplified collision and generic inertial URDF for Gazebo Harmonic stability -->
<robot name="intro_rover_description">

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <mass value="20.0" />
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.5" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://intro_rover_description/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="-0.05 0 0.15" rpy="0 0 0" />
      <geometry>
        <box size="0.7 0.6 0.25" />
      </geometry>
    </collision>
  </link>

  <link name="shoulder_yaw_link">
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://intro_rover_description/meshes/shoulder_yaw_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.866666666666667 0.909803921568627 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.06" />
      </geometry>
    </collision>
  </link>

  <joint name="shoulder_yaw" type="continuous">
    <origin xyz="0.17253 0 0.14797" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="shoulder_yaw_link" />
    <axis xyz="0 0 -1" />
    <dynamics damping="1.0" friction="0.1" />
  </joint>

  <link name="shoulder_pitch_link">
    <inertial>
      <origin xyz="-0.21 0.11 0" rpy="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://intro_rover_description/meshes/shoulder_pitch_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.866666666666667 0.909803921568627 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="-0.21 0.11 0" rpy="0 0 0" />
      <geometry>
        <box size="0.25 0.06 0.06" />
      </geometry>
    </collision>
  </link>

  <joint name="shoulder_pitch" type="revolute">
    <origin xyz="-0.10715 0 0.076542" rpy="1.5708 1.5708 0" />
    <parent link="shoulder_yaw_link" />
    <child link="shoulder_pitch_link" />
    <axis xyz="0 -1 0" />
    <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0" />
    <dynamics damping="2.0" friction="0.2" />
  </joint>

  <link name="elbow_pitch_link">
    <inertial>
      <origin xyz="0 0.10 -0.10" rpy="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://intro_rover_description/meshes/elbow_pitch_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.866666666666667 0.909803921568627 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.10 -0.10" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.06 0.15" />
      </geometry>
    </collision>
  </link>

  <joint name="elbow_pitch" type="revolute">
    <origin xyz="-0.42291 0.0032138 0.0097054" rpy="-0.60031 -1.5496 0.60041" />
    <parent link="shoulder_pitch_link" />
    <child link="elbow_pitch_link" />
    <axis xyz="0 -1 0" />
    <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0" />
    <dynamics damping="2.0" friction="0.2" />
  </joint>

  <link name="elbow_roll_link">
    <inertial>
      <origin xyz="0.40 0 -0.08" rpy="0 0 0" />
      <mass value="0.8" />
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01" />
